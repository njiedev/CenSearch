# Python package: censearch; LIKENESS_* settings remain compatible with existing data.
LIKENESS_DATA_DIR=data
LIKENESS_MODELS_DIR=models
LIKENESS_CALIBRATION_PATH=reports/calibration.json
MODEL_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=
CHAT_MODEL=hackathon-chat
MODEL_MAX_TOKENS=1024
OBJ_ENDPOINT=
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=
# Only explicit enabling allows public GET crawling; loopback works by default.
ALLOW_PUBLIC_CRAWL=false
CRAWL_DELAY=0.05
CRAWL_REQUEST_BUDGET=400
MOCK_BASE_PORT=8811
# Deployment only: set to the instance IPv4 plus .sslip.io.
APP_HOST=
# Generate interactively with: uv run python scripts/hash_password.py
# Use single quotes around the bcrypt hash in .env so Compose preserves dollar signs.
APP_PASSWORD_HASH=

# Delivery remains loopback-only. Do not enable external delivery for this project.
# LIKENESS_ALLOW_EXTERNAL_DELIVERY=1
LIKENESS_DEMO_CLOCK=0
LIKENESS_NOTICE_INTERVAL=172800
LIKENESS_SCHEDULER_POLL=30
# Optional local mock research adapters; never used for real-domain lookups.
LIKENESS_SMTP_RELAY=smtp://127.0.0.1:8818
LIKENESS_RDAP_BOOTSTRAP=http://127.0.0.1:8817/bootstrap
LIKENESS_SEARCH_ENDPOINT=http://127.0.0.1:8816/report
# Deploy default: LINODE_REGION=us-ord (override in your shell).
